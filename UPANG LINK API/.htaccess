# Enable URL rewriting
RewriteEngine On

# Set Authorization header if not present
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

# Handle CORS preflight requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Set CORS headers for all requests
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
Header always set Access-Control-Max-Age "3600"

# Handle spaces in URLs
RewriteRule ^UPANG\sLINK\sAPI/(.*)$ UPANG%20LINK%20API/$1 [L]

# Rewrite API requests to their PHP files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^UPANG%20LINK%20API/api/requests/types/?$ UPANG%20LINK%20API/api/requests/types.php [QSA,L]

# Default rewrite for other PHP files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ $1.php [QSA,L]

# Prevent directory listing
Options -Indexes

# Set default character encoding
AddDefaultCharset UTF-8

# Enable error logging
php_flag log_errors on
php_value error_log logs/error.log

# Enable debug output
php_flag display_errors on
php_flag display_startup_errors on

# Allow Authorization header
CGIPassAuth On
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1 