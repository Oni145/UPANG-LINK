<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/requirementName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/requiredText"
                android:layout_marginEnd="8dp"
                tools:text="Uniform Size" />

            <TextView
                android:id="@+id/requiredText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Required"
                android:textColor="#F44336"
                android:textSize="12sp"
                android:background="@drawable/bg_required_badge_horizontal"
                android:gravity="center"
                android:layout_alignParentEnd="true"
                android:visibility="visible" />

            <TextView
                android:id="@+id/optionalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Optional"
                android:textColor="#757575"
                android:textSize="12sp"
                android:background="@drawable/bg_optional_badge_horizontal"
                android:gravity="center"
                android:layout_alignParentEnd="true"
                android:visibility="gone" />
        </RelativeLayout>

        <TextView
            android:id="@+id/requirementDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#757575"
            tools:text="Please provide your uniform size" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/uploadButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Upload File"
            android:textColor="#4285F4"
            app:icon="@drawable/ic_upload"
            app:iconTint="#4285F4"
            app:strokeColor="#4285F4" />

        <TextView
            android:id="@+id/fileNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textSize="14sp"
            android:textColor="#4285F4"
            android:background="@drawable/bg_file_name"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@drawable/ic_file"
            android:visibility="gone"
            tools:text="clearance_form.pdf"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/inputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <!-- Input views will be added here programmatically -->

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView> 