<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uniform Size Chart"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#14213D"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Traditional Classic Fit | Modern Classic Fit | Contemporary Fit | Maternity"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#4285F4"
            android:textAlignment="center"
            android:layout_marginBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/titleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TableLayout
            android:id="@+id/sizeTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            app:layout_constraintTop_toBottomOf="@id/subtitleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Header Row -->
            <TableRow
                android:background="#14213D">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="US SIZE"
                    android:textColor="#FFFFFF"
                    android:padding="10dp"
                    android:gravity="center"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BUST"
                    android:textColor="#FFFFFF"
                    android:padding="10dp"
                    android:gravity="center"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WAIST"
                    android:textColor="#FFFFFF"
                    android:padding="10dp"
                    android:gravity="center"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HIPS"
                    android:textColor="#FFFFFF"
                    android:padding="10dp"
                    android:gravity="center"
                    android:textStyle="bold" />
            </TableRow>

            <!-- XXS Row -->
            <TableRow
                android:background="#E5E5E5">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="XXS\n0"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="31-31"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="23-24"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="33-34"
                    android:padding="10dp"
                    android:gravity="center" />
            </TableRow>

            <!-- XS Row -->
            <TableRow
                android:background="#F5F5F5">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="XS\n2-4"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="33-34"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="25-26"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="35-36"
                    android:padding="10dp"
                    android:gravity="center" />
            </TableRow>

            <!-- S Row -->
            <TableRow
                android:background="#E5E5E5">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="S\n6-8"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="35-36"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="27-28"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="37-38"
                    android:padding="10dp"
                    android:gravity="center" />
            </TableRow>

            <!-- M Row -->
            <TableRow
                android:background="#F5F5F5">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="M\n10-12"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="37-39"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="29-31"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="39-41"
                    android:padding="10dp"
                    android:gravity="center" />
            </TableRow>

            <!-- L Row -->
            <TableRow
                android:background="#E5E5E5">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="L\n14-16"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="40-43"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="32-35"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="42-45"
                    android:padding="10dp"
                    android:gravity="center" />
            </TableRow>

            <!-- XL Row -->
            <TableRow
                android:background="#F5F5F5">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="XL\n18-20"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="44-47"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="36-39"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="46-49"
                    android:padding="10dp"
                    android:gravity="center" />
            </TableRow>

            <!-- 2XL Row -->
            <TableRow
                android:background="#E5E5E5">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2XL\n22-24"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="48-51"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="40-43"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="50-53"
                    android:padding="10dp"
                    android:gravity="center" />
            </TableRow>

            <!-- 3XL Row -->
            <TableRow
                android:background="#F5F5F5">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3XL\n26-28"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="52-55"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="44-47"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="54-57"
                    android:padding="10dp"
                    android:gravity="center" />
            </TableRow>

            <!-- 4XL Row -->
            <TableRow
                android:background="#E5E5E5">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="4XL\n30-32"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="56-59"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="48-51"
                    android:padding="10dp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="58-62"
                    android:padding="10dp"
                    android:gravity="center" />
            </TableRow>
        </TableLayout>

        <TextView
            android:id="@+id/inseamText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INSEAM: Regular: 30-31 | Petite: 27½-28½ | Tall: 33-34"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#14213D"
            android:textAlignment="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/sizeTable"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/measurementNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(All measurements are in inches.)"
            android:textSize="12sp"
            android:textColor="#757575"
            android:textAlignment="center"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/inseamText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CLOSE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="12dp"
            android:layout_marginTop="20dp"
            app:cornerRadius="8dp"
            android:backgroundTint="#4285F4"
            app:layout_constraintTop_toBottomOf="@id/measurementNote"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView> 